# Copy this file to .env and fill in the keys you have. .env is ignored by git.
# The CLI loads .env from the project root at start. Library code reads os.environ only,
# so a key is never written into a results file.

# OpenRouter, for `stargazer agent --backend openai` (default base URL is OpenRouter).
OPENROUTER_API_KEY=

# Thinking Machines Tinker, for `stargazer agent --backend tinker` and the RL phase.
TINKER_API_KEY=

# Optional: another OpenAI-compatible endpoint, for example a local vLLM or Ollama server.
# Pass it with `--base-url` and name the key variable with `--api-key-env`.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
